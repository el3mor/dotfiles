{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "margin-top": 10,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock#time"
  ],
  "modules-right": [
    "idle_inhibitor",
    "hyprland/language",
    "cpu",
    "memory",
    "network",
    "battery",
    "pulseaudio",
    "tray",
    "clock#date",
    "custom/power"
  ],
  "custom/logo": {
    "format": ""
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "all-outputs": true
  },
  "hyprland/language": {
    "format": "{}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "cpu": {
    "format": " {usage}%"
  },
  "memory": {
    "format": "󰍛 {}%"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "format-charging": " {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "pulseaudio": {
    "format": " {volume}%"
  },
  "tray": {
    "spacing": 8
  },
  "clock#date": {
    "format": " {:%a %d %b}"
  },
  "clock#time": {
    "format": " {:%I:%M %p}"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": false
  }
}
